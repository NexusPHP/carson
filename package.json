{
  "name": "carson",
  "version": "0.1.0",
  "private": true,
  "description": "A GitHub App that manages your repository like a butler.",
  "homepage": "https://github.com/NexusPHP/carson#readme",
  "bugs": {
    "url": "https://github.com/NexusPHP/carson/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexusPHP/carson.git"
  },
  "license": "MIT",
  "author": "John Paul E. Balandan, CPA <paulbalandan@gmail.com>",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "all": "npm run lint && npm run typecheck && npm test",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js --banner:js=\"import { createRequire as __cr } from 'module'; const require = __cr(import.meta.url);\"",
    "dev": "tsx watch src/dev.ts",
    "lint": "eslint --color src tests docs \"*.config.ts\"",
    "lint:fix": "eslint --color --fix src tests docs \"*.config.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/webhooks": "^14.2.0",
    "picomatch": "^4.0.5",
    "probot": "^14.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@octokit/openapi-types": "^27.0.0",
    "@stylistic/eslint-plugin": "^5.0.0",
    "@types/node": "^26.1.0",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "jiti": "^2.4.2",
    "nock": "^14.0.16",
    "smee-client": "^5.0.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": "^24 || ^26",
    "npm": "^11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
